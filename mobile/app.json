{
  "expo": {
    "name": "MealBridge",
    "slug": "mealbridge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mealbridge.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.mealbridge.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MealBridge uses your location to match food donations with nearby organizations."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MealBridge lets you attach a photo of the food you are donating."
        }
      ]
    ],
    "scheme": "mealbridge"
  }
}
